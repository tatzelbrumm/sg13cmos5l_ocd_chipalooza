#
# user_projects.tcl --- GENERATED by scripts/get_project_gds.sh
#
# Do not edit.  Regenerate with "make projects-gds" whenever a user
# project GDS changes or a slot moves in chipalooza_frame.
#
# Sourced from run_gen_prefill_gds.sh with sg13cmos5l_ocd_chipalooza
# as the edit cell, from the magic/ directory.  The final (filled) GDS
# is built from the pre-fill GDS and so needs no separate placement.
#
# Projects placed:      7
#

# Positions are in microns, so that the internal-unit scaling of any
# .mag file cannot come into it.
units microns

# readonly drops each user GDS in verbatim.  The GDS_START/GDS_END
# properties are cleared per cell below, which is what makes magic
# prefix the subcells so user cell names cannot collide.  This must
# be done in conjunction with the noduplicates option, otherwise
# name collision can still occur when reading the cells.
gds readonly true
gds noduplicates true

gds read ../dependencies/slot_7/final/gds/slot_7.gds
# Slots whose GDS turned out not to contain the expected top level
# cell.  A missing cell is recorded here and the slot is skipped at
# placement time below, so that one bad project leaves its own slot
# empty rather than aborting magic and losing the whole chip GDS.
set missing_slots {}

# slot 7 --- dependencies/slot_7/final/gds/slot_7.gds
if {[lsearch [cellname list allcells] slot_7] < 0} {
    puts "ERROR: slot_7.gds contains no cell named slot_7"
    puts "       slot 7 not placed:  no getcell was done."
    puts "       NOTE:  if the project was laid out directly in"
    puts "       slot7_wrapper it replaces the harness wrapper of"
    puts "       that name and may still appear in the chip anyway."
    puts "       Check the slot visually, and rely on chip level LVS"
    puts "       to confirm the slot pins survived."
    lappend missing_slots 7
} else {
    load slot_7
    # Properties apply to the current edit cell, so these must stay
    # inside the else, after the load.
    property GDS_END ""
    property GDS_START 0
    property LEFview true
}

load sg13cmos5l_ocd_chipalooza

if {[lsearch $missing_slots 7] >= 0} {
    puts "skipping slot 7 (top level cell not found)"
} else {
    # Remove any existing slot instance
    if {[instance list exists slot_7_0] != ""} {
        select cell slot_7_0
        delete
    }
    getcell slot_7 child 0 0 parent 1379.95 2170.05
}

# Final tally, so a missing slot cannot scroll past unnoticed in
# magic's output.
if {[llength $missing_slots] > 0} {
    puts ""
    puts "WARNING: slot(s) not placed, no top level cell found: $missing_slots"
    puts "The chip GDS was still written.  Those slots are empty unless"
    puts "the project was laid out directly in its slotN_wrapper cell."
    puts ""
}
