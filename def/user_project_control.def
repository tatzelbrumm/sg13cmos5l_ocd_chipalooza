VERSION 5.7 ;
   NAMESCASESENSITIVE ON ;
   DIVIDERCHAR "/" ;
   BUSBITCHARS "()" ;
   DESIGN user_project_control ;
   TECHNOLOGY ihp-sg13cmos5l ;
