diff --git a/scripts/custom_io.tcl b/scripts/custom_io.tcl
new file mode 100644
index 0000000..e75c625
--- /dev/null
+++ b/scripts/custom_io.tcl
@@ -0,0 +1,81 @@
+#----------------------------------------------------------------
+# custom_io.tcl --
+#
+# Label procedures for custom (non-foundry) I/O pad cells, the
+# counterpart of label_right_analog / label_left_analog in
+# gen_padframe_template.tcl.  Sourced by gen_padframe.tcl (only used
+# if config.txt names a custom pad type) and by
+# run_update_frame_custom_io.sh.  Units:  microns.
+#
+# A custom pad brings each core-side signal out on Metal2 at the
+# core edge of the pad (0.29 um wide stubs, pitch down to 0.54 um).
+# Per pin, label_<side>_custom paints, in the cell being edited:
+#
+#   - a Via2 (0.2 x 0.2) on the pad's own M2 stub, 0.05 um inside the
+#     pad's core edge (M2 enclosure >= 0.04 at the sides),
+#   - a Metal3 strap 0.29 um wide from 0.3 um inside the pad edge
+#     to 1.1 um outside it (into the core = the slot area), like the
+#     1.1 um strip of label_right_analog,
+#   - a label with port on the part of the strap outside the pad.
+#
+# At 0.54 um pitch the straps are 0.25 um apart (Metal3 min. 0.21).
+# The via and the strap inside the pad touch nothing of the pad but
+# its pin stub (pad Metal3 ends 2 um from the core edge).
+#----------------------------------------------------------------
+
+# Return the strap geometry {via m3 label} as three boxes {llx lly urx ury}
+# for pin "pin_name" of pad instance "pad_name".  side is "right" (pad
+# rotated 270, core edge = west edge) or "left" (pad rotated 90, core
+# edge = east edge).
+proc custom_io_rects {side pad_name pin_name} {
+    set ibox [instance list abutment $pad_name]
+    goto ${pad_name}/${pin_name}
+    set lbox [box values]
+    set yc [expr {([lindex $lbox 1] + [lindex $lbox 3]) / 2.0}]
+    # Everything is placed on the 10 nm grid:  the padframe session runs
+    # on a 10 nm internal grid and rounds finer coordinates, and the
+    # chipalooza_frame copy (run_update_frame_custom_io.sh) must be
+    # identical.  The 0.29 um strap and the 0.2 um via start at the 10 nm
+    # position at or just below (pin center - half width):  at most 5 nm
+    # off the pin (M2 enclosure of the via >= 0.04 along the edge, 0.05
+    # at the pad edge).
+    set yc [expr {round($yc * 200.0) / 200.0}]
+    set y0 [expr {floor(($yc - 0.145) * 100.0 + 1e-6) / 100.0}]
+    set y1 [expr {$y0 + 0.29}]
+    set v0 [expr {floor(($yc - 0.1) * 100.0 + 1e-6) / 100.0}]
+    set v1 [expr {$v0 + 0.2}]
+    if {$side == "right"} {
+	set xe [lindex $ibox 0]
+	set via [list [expr {$xe + 0.05}] $v0 [expr {$xe + 0.25}] $v1]
+	set m3  [list [expr {$xe - 1.1}] $y0 [expr {$xe + 0.3}] $y1]
+	set lab [list [expr {$xe - 1.1}] $y0 [expr {$xe - 0.3}] $y1]
+    } else {
+	set xe [lindex $ibox 2]
+	set via [list [expr {$xe - 0.25}] $v0 [expr {$xe - 0.05}] $v1]
+	set m3  [list [expr {$xe - 0.3}] $y0 [expr {$xe + 1.1}] $y1]
+	set lab [list [expr {$xe + 0.3}] $y0 [expr {$xe + 1.1}] $y1]
+    }
+    return [list $via $m3 $lab]
+}
+
+proc custom_io_paint {rects pin_text {with_via 1}} {
+    lassign $rects via m3 lab
+    if {$with_via} {
+	box values {*}$via
+	paint via2
+    }
+    box values {*}$m3
+    paint m3
+    box values {*}$lab
+    label $pin_text FreeSans 0.3 0 0 0 c m3
+    port make
+}
+
+# Label a custom pad core pin on the right / left side (padframe).
+proc label_right_custom {pad_name pin_name pin_text} {
+    custom_io_paint [custom_io_rects right $pad_name $pin_name] $pin_text 1
+}
+
+proc label_left_custom {pad_name pin_name pin_text} {
+    custom_io_paint [custom_io_rects left $pad_name $pin_name] $pin_text 1
+}
diff --git a/scripts/custom_io_manifest.py b/scripts/custom_io_manifest.py
new file mode 100755
index 0000000..8ded52c
--- /dev/null
+++ b/scripts/custom_io_manifest.py
@@ -0,0 +1,102 @@
+#!/usr/bin/env python3
+#---------------------------------------------------------------
+# custom_io_manifest.py ---
+#
+# Find the custom (non-foundry) pad cells named in config.txt and
+# their descriptions in the slot repositories.
+#
+# A slot whose config.txt entries name a pad type that is not one of
+# the foundry pad types must deliver that pad in its own repository
+# (the submodule dependencies/slot_<N>), on its default branch:
+#
+#	pads/pads.txt			manifest, one line per pad cell:
+#					  <cell>  <config.txt pad>  <core-side pins...>
+#					(core-side pins in order along the
+#					pad's core edge;  '#' starts a comment)
+#	pads/<cell>/<cell>.gds		layout, top cell <cell>
+#	pads/<cell>/<cell>.spice	LVS netlist, .subckt <cell>
+#
+# Nothing of the pad is stored in the harness.  Used by
+# scripts/setup_custom_io.py and scripts/parse_config.py.
+#---------------------------------------------------------------
+
+import os
+import re
+import sys
+
+FOUNDRY_PADS = {
+    'sg13cmos5l_IOPadIn',
+    'sg13cmos5l_IOPadOut4mA', 'sg13cmos5l_IOPadOut16mA', 'sg13cmos5l_IOPadOut30mA',
+    'sg13cmos5l_IOPadTriOut4mA', 'sg13cmos5l_IOPadTriOut16mA', 'sg13cmos5l_IOPadTriOut30mA',
+    'sg13cmos5l_IOPadInOut4mA', 'sg13cmos5l_IOPadInOut16mA', 'sg13cmos5l_IOPadInOut30mA',
+    'sg13cmos5l_IOPadAnalog',
+}
+
+# Ring-side pins of a custom pad:  connected like an analog pad's, not
+# core signals.
+RING_PINS = {'pad', 'iovdd', 'iovss', 'vdd', 'vss'}
+
+IDXREX = re.compile(r'^s([0-9]+)_an\[([0-9]+)\]:[ \t]+([^ \t]+)[ \t]+([^ \t]+)$')
+
+
+def read_config(project_path):
+    """{(slot, pin): (pad_type, signal_name)} from config.txt, as parse_config.py reads it."""
+    padlist = {}
+    with open(os.path.join(project_path, 'config.txt')) as ifile:
+        for line in ifile.read().splitlines():
+            m = IDXREX.match(line)
+            if m:
+                padlist[m.group(1), m.group(2)] = [m.group(3), m.group(4)]
+    return padlist
+
+
+def custom_pads(project_path, padlist=None):
+    """{cell: {'slot': N, 'pins': [...], 'dir': <path of pads/<cell>>, 'index': k}}
+    for every non-foundry pad type in config.txt.  Exits with an error
+    message if a slot does not deliver a pad its config.txt entry names."""
+    if padlist is None:
+        padlist = read_config(project_path)
+    found = {}
+    for (slot, pin), (pad_type, signal) in sorted(padlist.items()):
+        if pad_type in FOUNDRY_PADS or pad_type in found:
+            continue
+        padsdir = os.path.join(project_path, 'dependencies', 'slot_' + slot, 'pads')
+        manifest = os.path.join(padsdir, 'pads.txt')
+        if not os.path.isfile(manifest):
+            sys.exit(f'Error:  s{slot}_an[{pin}] is "{pad_type}", which is not a foundry pad type, and\n'
+                     f'        {os.path.relpath(manifest, project_path)} does not exist.\n'
+                     f'        Run "make projects SLOTS={slot}" first, or check the pad type.')
+        entries = []
+        with open(manifest) as ifile:
+            for line in ifile:
+                line = line.split('#', 1)[0].split()
+                if line:
+                    entries.append(line)
+        names = [e[0] for e in entries]
+        if pad_type not in names:
+            sys.exit(f'Error:  pad type "{pad_type}" (s{slot}_an[{pin}]) is not listed in\n'
+                     f'        {os.path.relpath(manifest, project_path)}')
+        k = names.index(pad_type)
+        entry = entries[k]
+        celldir = os.path.join(padsdir, pad_type)
+        for ext in ('gds', 'spice'):
+            f = os.path.join(celldir, pad_type + '.' + ext)
+            if not os.path.isfile(f):
+                sys.exit(f'Error:  {os.path.relpath(f, project_path)} is missing')
+        found[pad_type] = {'slot': slot, 'pins': entry[2:], 'dir': celldir, 'index': k}
+    return found
+
+
+def mag_core_pins(project_path, cell):
+    """Port names of magic/custom_io/<cell>.mag minus the ring-side pins."""
+    magfile = os.path.join(project_path, 'magic', 'custom_io', cell + '.mag')
+    if not os.path.isfile(magfile):
+        sys.exit(f'Error:  magic/custom_io/{cell}.mag does not exist.  Run "make setup-custom" first.')
+    ports, last = set(), None
+    with open(magfile) as ifile:
+        for line in ifile.read().splitlines():
+            if line.startswith('rlabel') or line.startswith('flabel'):
+                last = line.split()[-1]
+            elif line.startswith('port ') and last:
+                ports.add(last)
+    return ports - RING_PINS
