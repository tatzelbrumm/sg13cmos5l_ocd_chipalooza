diff --git a/scripts/run_update_frame_custom_io.sh b/scripts/run_update_frame_custom_io.sh
new file mode 100755
index 0000000..cecd43b
--- /dev/null
+++ b/scripts/run_update_frame_custom_io.sh
@@ -0,0 +1,95 @@
+#!/bin/bash
+#
+# run_update_frame_custom_io.sh --- remove the stale hand-made copies of
+# the default pads' core-side strips from chipalooza_frame where a custom
+# pad has replaced the default pad.
+#
+# Why:  run_gen_user_wrappers.sh carves the slot wrappers out of
+# chipalooza_frame, taking both its flat paint and the paint of the
+# expanded subcell chipalooza_frame_wrapper_0 (the cell generated by
+# "make padframe", placed in chipalooza_frame at +1 internal unit in y).
+# chipalooza_frame.mag also holds hand-made FLAT copies of the pad-edge
+# strips of the default analog pads (s<N>_an[x], s<N>_an_x_esd).  When a
+# pad becomes a custom pad, these stale copies would stay in the slot
+# wrapper next to the new pins (as happens in main for slot 6, whose
+# wrapper has both its analog and its digital labels).
+#
+# What:  for every pad named in a "label_<side>_custom <pad> <pin> <text>"
+# line of the generated scripts/gen_padframe.tcl (from make config), this
+# script erases, in chipalooza_frame only (not in its subcells), the
+# Metal2/Metal3 paint and the labels in the core-edge band of that pad
+# (1.2 um outside to 1.0 um inside the pad's core edge, over the pad's
+# full length).  The new pins then come only from chipalooza_frame_wrapper.
+# chipalooza_frame and sg13cmos5l_padframe share one origin in the chip top
+# level, so padframe coordinates are used as they are.  Only bands of
+# custom pads are touched;  if there are none, nothing is written.
+#
+# Run from the top level directory, after "make padframe" and before
+# "make wrappers".
+
+export PDK_ROOT=${PDK_ROOT:-/home/tim/gits}
+export PDK=${PDK:-ihp-sg13cmos5l}
+
+if ! grep -q '^[ \t]*label_\(right\|left\)_custom ' scripts/gen_padframe.tcl; then
+    echo "No custom pads in scripts/gen_padframe.tcl;  chipalooza_frame unchanged."
+    exit 0
+fi
+
+cd magic
+
+magic -dnull -noconsole -rcfile ${PDK_ROOT}/${PDK}/libs.tech/magic/${PDK}.magicrc << EOF
+drc off
+crashbackups stop
+locking disable
+source ../scripts/layout_setup.tcl
+addpath paramcells
+units microns
+
+# Collect the custom pad pins from the generated padframe script
+set pins {}
+set fh [open ../scripts/gen_padframe.tcl r]
+foreach line [split [read \$fh] "\n"] {
+    if {[regexp {^\s*label_(right|left)_custom\s+(\S+)\s+(\S+)\s+(\S+)} \$line -> side pad pin text]} {
+	lappend pins [list \$side \$pad \$pin \$text]
+    }
+}
+close \$fh
+
+# Pad bands from the padframe
+load sg13cmos5l_padframe
+select top cell
+array set bands {}
+foreach p \$pins {
+    lassign \$p side pad pin text
+    # (as in gen_padframe.tcl:  select the instance, then ask for its abutment box)
+    select cell \$pad
+    set ibox [instance list abutment]
+    if {\$side == "right"} {
+	set xe [lindex \$ibox 0]
+	set bands(\$pad) [list [expr {\$xe - 1.2}] [lindex \$ibox 1] [expr {\$xe + 1.0}] [lindex \$ibox 3]]
+    } else {
+	set xe [lindex \$ibox 2]
+	set bands(\$pad) [list [expr {\$xe - 1.0}] [lindex \$ibox 1] [expr {\$xe + 1.2}] [lindex \$ibox 3]]
+    }
+}
+
+# Edit chipalooza_frame
+load chipalooza_frame
+select top cell
+foreach pad [array names bands] {
+    box values {*}\$bands(\$pad)
+    select area
+    puts "FRAME band \$pad \$bands(\$pad) before: [what -list]"
+    select clear
+    erase m2,m3
+    erase labels
+    select area
+    puts "FRAME band \$pad after: [what -list]"
+    select clear
+}
+save chipalooza_frame
+quit -noprompt
+EOF
+
+echo "Done!"
+exit 0
-- 
