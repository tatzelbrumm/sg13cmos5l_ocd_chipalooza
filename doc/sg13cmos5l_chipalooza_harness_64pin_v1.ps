/sg13cmos5l_padframe.ppmdata exch def
/sg13cmos5l_padframe.ppm <<
  /ImageType 1 /Width 1000 /Height 1500 /BitsPerComponent 8
  /MultipleDataSources false
  /Decode [0 1 0 1 0 1]
  /ImageMatrix [1 0 0 -1 500 750]
  /DataSource sg13cmos5l_padframe.ppmdata >> def

/generic::arrowhead {
% nonetwork
begingate
8 -28 beginpath
3 -18 3 -15 0 0 curveto
-3 -15 -3 -18 -8 -28 curveto
-2 -26 2 -26 8 -28 curveto
249 
1.000 endpath
endgate
} def

/generic::dot {
% trivial
begingate
248 1.000 0 0 6 0.000 360.000 xcarc
1.000 0.000 0.000 scb
(x) {/Times-Roman cf} 2 29 -0.000 1.000 0 0 pinlabel
endgate
} def


